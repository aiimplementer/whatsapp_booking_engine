# Neon connection string. Use the DIRECT (non-pooled) connection for Alembic migrations;
# the app itself can use either — pooled is fine for normal request traffic.
# NOTE: SQLAlchemy async needs the "+asyncpg" driver marker, which Neon's console
# connection string does NOT include by default — add it yourself, see below.
#
# Neon gives you:   postgresql://user:pass@host/db?sslmode=require
# You need:         postgresql+asyncpg://user:pass@host/db?ssl=require
#   - add "+asyncpg" after "postgresql"
#   - asyncpg wants "ssl=require", not "sslmode=require" (different query param name)
# NOTE ON ROLES: use the `app_user` role here (see README's "RLS role setup"
# section), NOT `neondb_owner`. Postgres lets a table's owner bypass Row Level
# Security entirely — if the app connects as the owner, every RLS policy in
# the schema silently does nothing.
DATABASE_URL=postgresql+asyncpg://app_user:PASSWORD@ep-old-bar-b3rfvsry.c-4.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# Same DB, but with a plain "postgresql://" (psycopg2-style) driver — Alembic's
# offline/sync tooling uses this one. Same credentials, different scheme prefix.
DATABASE_URL_SYNC=postgresql://neondb_owner:PASSWORD@ep-old-bar-b3rfvsry.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

ENVIRONMENT=development

# Generate with: openssl rand -hex 32
# Never reuse this across environments, never commit the real value.
JWT_SECRET_KEY=changeme-generate-a-real-random-secret

# --- WhatsApp Cloud API (Meta) ---
# Invent this yourself (any random string) and paste the SAME value into
# Meta App dashboard > WhatsApp > Configuration > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=changeme-any-random-string
# Meta App dashboard > App Settings > Basic > App Secret
WHATSAPP_APP_SECRET=
# A permanent token for a System User with whatsapp_business_messaging
# permission (Meta Business Settings > System Users) — NOT the 24h temporary
# token shown by the quickstart, that one expires and will break in prod.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- Platform admin console: https://<host>/platform-admin ---
# Nominal HTTP Basic auth, one shared operator account. Generate the hash with:
#   python -c "from app.security import hash_password; print(hash_password('yourpassword'))"
# Leave PLATFORM_ADMIN_PASSWORD_HASH empty to keep the console locked (503).
PLATFORM_ADMIN_USERNAME=platform-admin
PLATFORM_ADMIN_PASSWORD_HASH=

# --- Telegram Bot API connector (optional, independent of WhatsApp) ---
# Optional shared secret Telegram will echo back on every webhook POST once
# a tenant connects (see app/services/telegram_client.py). Leave blank for
# local dev — the per-tenant bot token in the webhook URL path is still
# required and acts as the primary secret.
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of this deployment, e.g. https://mybooking.app — used only
# to auto-register a tenant's webhook with Telegram at /connect time. Leave
# blank to save the bot token without auto-registering (call Telegram's
# setWebhook yourself instead).
PUBLIC_BASE_URL=

# --- Gmail OAuth2 (appointment booked/cancelled emails) ---
# One platform-wide Gmail/Workspace mailbox sends every notification email
# (not per-tenant). Get these from Google Cloud Console > APIs & Services >
# Credentials (OAuth client ID, type "Web application"), then run the
# consent flow once with scope https://www.googleapis.com/auth/gmail.send,
# access_type=offline, prompt=consent to get a refresh token — the OAuth
# Playground (https://developers.google.com/oauthplayground, using your own
# client id/secret under its gear icon) is the quickest way to do this.
# Leave GMAIL_REFRESH_TOKEN blank to disable email sending entirely.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=ScheduleMate
